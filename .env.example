# Copy to .env and fill in your MySQL connection details.
# On Vercel, set the same names under Project Settings → Environment Variables.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leave_logs

# Online MySQL (Aiven etc.) needs an encrypted connection. Paste the provider's
# CA certificate on one line, with each line break written as \n:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----\n
# Or, if the provider's certificate is publicly trusted, use instead:
# DB_SSL=true

# Local server only (ignored on Vercel).
PORT=3000
